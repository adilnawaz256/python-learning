# Application Configuration
APP_NAME=noc-ingestion
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=noc-raw-data

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=telecom-events
KAFKA_GROUP_ID=noc-ingestion-group
KAFKA_AUTO_OFFSET_RESET=earliest

# REST Collector Configuration
DEFAULT_REST_TIMEOUT_SECONDS=30
DEFAULT_MAX_RETRIES=3

# Database Configuration (PostgreSQL Audit Log)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=noc_audit
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/noc_audit

# API Authentication Token
API_TOKEN=noc-secret-ingestion-token-2026

# Demo Mode Generator
DEMO_MODE=true
DEMO_INTERVAL_KAFKA_SECONDS=5
DEMO_INTERVAL_FILE_SECONDS=60
