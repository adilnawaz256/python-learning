{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total Network Events",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT COALESCE(COUNT(*), 0) AS total_events FROM iceberg.noc.network_events",
          "refId": "Total_Network_Events"
        }
      ]
    },
    {
      "title": "Events by Severity",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT severity_clean AS severity, COUNT(*) AS count FROM iceberg.noc.network_events GROUP BY severity_clean",
          "refId": "Network_Severity"
        }
      ]
    },
    {
      "title": "Events by Region",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT region, COUNT(*) AS count FROM iceberg.noc.network_events GROUP BY region",
          "refId": "Network_Region"
        }
      ]
    },
    {
      "title": "Network Events Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT date_trunc('hour', event_timestamp) AS time, COUNT(*) AS events_count FROM iceberg.noc.network_events GROUP BY 1 ORDER BY 1",
          "refId": "Network_Trend"
        }
      ]
    },
    {
      "title": "Recent Network Events Log",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT event_id, node_id, region, severity_clean, event_timestamp FROM iceberg.noc.network_events ORDER BY event_timestamp DESC LIMIT 50",
          "refId": "Network_Log"
        }
      ]
    }
  ],
  "refresh": "10s",
