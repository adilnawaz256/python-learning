    {
      "title": "Trouble Tickets Creation Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT date_trunc('hour', event_timestamp) AS time, COUNT(*) AS tickets_count FROM iceberg.noc.tickets GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "title": "Recent Incident Ticket Log",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT event_id AS \"Ticket ID\", source AS \"Assigned Group\", severity_clean AS \"Priority\", event_timestamp AS \"Created Timestamp\" FROM iceberg.noc.tickets ORDER BY event_timestamp DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
