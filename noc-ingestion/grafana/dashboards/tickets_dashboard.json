{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total Incident Tickets",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT COALESCE(COUNT(*), 0) AS total_tickets FROM iceberg.noc.tickets",
          "refId": "Total_Tickets"
        }
      ]
    },
    {
      "title": "Tickets by Priority",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT severity_clean AS priority, COUNT(*) AS count FROM iceberg.noc.tickets GROUP BY severity_clean",
          "refId": "Tickets_Priority"
        }
      ]
    },
    {
      "title": "Tickets by Assigned Group",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT source AS assigned_group, COUNT(*) AS count FROM iceberg.noc.tickets GROUP BY source",
          "refId": "Tickets_Group"
        }
      ]
    },
    {
      "title": "Trouble Tickets Creation Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT date_trunc('hour', event_timestamp) AS time, COUNT(*) AS tickets_count FROM iceberg.noc.tickets GROUP BY 1 ORDER BY 1",
          "refId": "Tickets_Trend"
        }
      ]
    },
    {
      "title": "Recent Incident Ticket Log",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "rawSql": "SELECT event_id, source AS assigned_group, severity_clean AS priority, event_timestamp FROM iceberg.noc.tickets ORDER BY event_timestamp DESC LIMIT 50",
          "refId": "Tickets_Log"
        }
      ]
    }
  ],
