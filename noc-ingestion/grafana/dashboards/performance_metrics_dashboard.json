  "panels": [
    {
      "title": "Total Metric Telemetry Records",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT COALESCE(COUNT(*), 0) AS total_metrics FROM iceberg.noc.performance_metrics",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "title": "Metrics by Severity Level",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT severity_clean AS severity, COUNT(*) AS count FROM iceberg.noc.performance_metrics GROUP BY severity_clean",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
