    {
      "title": "Metrics Trend Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT date_trunc('hour', event_timestamp) AS time, COUNT(*) AS metric_count FROM iceberg.noc.performance_metrics GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "title": "Recent Performance Metrics Log",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT event_id AS \"Event ID\", node_id AS \"Node ID\", region AS \"Region\", severity_clean AS \"Severity\", event_timestamp AS \"Event Timestamp\" FROM iceberg.noc.performance_metrics ORDER BY event_timestamp DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
