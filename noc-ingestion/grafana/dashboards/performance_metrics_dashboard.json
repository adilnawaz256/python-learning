          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Monitored Devices by Region",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "trino", "uid": "Trino Iceberg" },
          "format": "table",
          "rawSql": "SELECT region, COUNT(*) AS count FROM iceberg.noc.performance_metrics GROUP BY region",
          "refId": "A"
        }
      ],
      "options": {
        "xTickLabelRotation": 0,
        "legend": {
